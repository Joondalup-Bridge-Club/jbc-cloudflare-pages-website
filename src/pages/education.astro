---
import SiteLayout from "../layouts/SiteLayout.astro";
import page from "../data/pages/education.json";
---
<SiteLayout title="Learn bridge | Joondalup Bridge Club" description="Beginner lessons and starter sessions at Joondalup Bridge Club.">
  <section class="page-hero">
    <p class="eyebrow">{page.hero.eyebrow}</p>
    <h1>{page.hero.heading}</h1>
    <p>{page.hero.intro}</p>
  </section>
  <section class="section page-content">
    <div class="content-columns education-columns">
      <article class="feature-card">
        <p class="eyebrow">{page.course.eyebrow}</p>
        <h2>{page.course.heading}</h2>
        {page.course.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        <a class="button button-primary" href={page.course.emailUrl}>{page.course.action} <span aria-hidden="true">→</span></a>
      </article>
      <article class="feature-card starter-card">
        <p class="eyebrow">{page.starter.eyebrow}</p><h2>{page.starter.heading}</h2>
        <p>{page.starter.text}</p>
        <p><strong>{page.starter.time}</strong></p>
        <a class="text-link" href="/sessions/">{page.starter.action} <span aria-hidden="true">→</span></a>
      </article>
    </div>
    <div class="club-links-grid education-resources">
      {page.resources.map((item) => <a class="club-link-card" href={item.url} target="_blank" rel="noreferrer"><span class="eyebrow">{item.eyebrow}</span><strong>{item.title}</strong><b aria-hidden="true">↗</b></a>)}
    </div>
    <div class="welcome-band education-band"><div class="welcome-mark" aria-hidden="true">♠</div><div><p class="eyebrow">{page.welcome.eyebrow}</p><h2>{page.welcome.heading}</h2><p>{page.welcome.text}</p></div><a class="button button-light" href={page.welcome.emailUrl}>{page.welcome.action} <span aria-hidden="true">→</span></a></div>
  </section>
</SiteLayout>
