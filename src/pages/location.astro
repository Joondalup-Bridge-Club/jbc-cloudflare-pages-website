---
import SiteLayout from "../layouts/SiteLayout.astro";
import page from "../data/pages/location.json";
---
<SiteLayout title="Location and contact | Joondalup Bridge Club" description="Visit Joondalup Bridge Club at Fleur Freame Pavilion in Padbury, Western Australia.">
  <section class="page-hero">
    <p class="eyebrow">{page.hero.eyebrow}</p>
    <h1>{page.hero.heading}</h1>
    <p>{page.hero.intro}</p>
  </section>
  <section class="section page-content visit-grid">
    <article class="feature-card">
      <p class="eyebrow">{page.venue.eyebrow}</p>
      <h2>{page.venue.heading}</h2>
      <p>{page.venue.address.map((line) => <>{line}<br /></>)}</p>
      <a class="button button-primary" href={page.venue.directionsUrl} target="_blank" rel="noreferrer">{page.venue.directions} <span aria-hidden="true">↗</span></a>
      <p class="location-detail">{page.venue.detail}</p>
    </article>
    <article class="feature-card">
      <p class="eyebrow">{page.arrival.eyebrow}</p>
      <h2>{page.arrival.heading}</h2>
      <ul>
        {page.arrival.items.map((item) => <li>{item}</li>)}
      </ul>
      <a class="text-link" href="/sessions/">{page.arrival.action} <span aria-hidden="true">→</span></a>
    </article>
    <article class="feature-card contact-card">
      <p class="eyebrow">{page.contact.eyebrow}</p><h2>{page.contact.heading}</h2>
      <p>{page.contact.text}</p>
      <a class="button button-primary" href={page.contact.emailUrl}>{page.contact.action} <span aria-hidden="true">→</span></a>
    </article>
  </section>
</SiteLayout>
