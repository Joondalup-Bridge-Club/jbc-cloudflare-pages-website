---
import SiteLayout from "../layouts/SiteLayout.astro";
import page from "../data/pages/club.json";
---
<SiteLayout title="About the club | Joondalup Bridge Club" description="Club contacts, membership information and useful links.">
  <section class="page-hero">
    <p class="eyebrow">{page.hero.eyebrow}</p>
    <h1>{page.hero.heading}</h1>
    <p>{page.hero.intro}</p>
  </section>
  <section class="section page-content">
    <div class="feature-card club-intro">
      <p class="eyebrow">{page.introCard.eyebrow}</p>
      <h2>{page.introCard.heading}</h2>
      {page.introCard.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      <a class="text-link" href="/location/">{page.introCard.action} <span aria-hidden="true">→</span></a>
    </div>
    <div class="club-links-grid">
      {page.pages.map((item) => <a class="club-link-card" href={item.href}><span class="eyebrow">Club information</span><strong>{item.title}</strong><span>{item.text}</span><b aria-hidden="true">→</b></a>)}
    </div>
  </section>
</SiteLayout>
