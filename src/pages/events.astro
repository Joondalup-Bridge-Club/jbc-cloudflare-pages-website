---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout title="Events | Joondalup Bridge Club" description="Event signups and calendar information for Joondalup Bridge Club.">
  <section class="page-hero">
    <p class="eyebrow">What's on</p>
    <h1>Club events</h1>
    <p>See current event signups and information about weekly sessions.</p>
  </section>
  <section class="section page-content">
    <div class="feature-card event-card"><p class="eyebrow">Special events</p><h2>Signup.com</h2><p>Check the club signup page for current events. Please register at least three days beforehand.</p><a class="button button-primary" href="https://signup.com/go/XBxrgry" target="_blank" rel="noreferrer">View event signups <span aria-hidden="true">↗</span></a></div>
    <div class="notice-card"><strong>Looking for a regular game?</strong><span>We run sessions throughout the week, including hosted games and a supervised starter session.</span></div>
    <a class="text-link" href="/sessions/">View weekly session times <span aria-hidden="true">→</span></a>
  </section>
</SiteLayout>
