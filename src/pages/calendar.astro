---
import SiteLayout from "../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";
import { formatEventDate, formatEventTime, getUpcomingEvents } from "../data/event-utils";
import page from "../data/pages/calendar.json";

const upcomingEvents = getUpcomingEvents(await getCollection("events"));
const hostedSessions = (await getCollection("sessions"))
  .map(({ data }) => data)
  .filter((session) => session.hosted && session.hostRegistration);
---
<SiteLayout title="Club calendar | Joondalup Bridge Club" description="Weekly sessions and event signup information for Joondalup Bridge Club.">
  <section class="page-hero">
    <p class="eyebrow">{page.hero.eyebrow}</p>
    <h1>{page.hero.heading}</h1>
    <p>{page.hero.intro}</p>
  </section>
  <section class="section page-content">
    <div class="content-columns">
      <article class="feature-card">
        <p class="eyebrow">{page.regular.eyebrow}</p><h2>{page.regular.heading}</h2>
        <p>{page.regular.text}</p>
        <a class="button button-primary" href="/sessions/">{page.regular.action} <span aria-hidden="true">→</span></a>
      </article>
      <article class="feature-card event-card">
        <p class="eyebrow">{page.events.eyebrow}</p><h2>{page.events.heading}</h2>
        <p>{page.events.text}</p>
        <a class="button button-primary" href={page.events.url} target="_blank" rel="noreferrer">{page.events.action} <span aria-hidden="true">↗</span></a>
      </article>
    </div>
    {upcomingEvents.length > 0 && (
      <section class="upcoming-events-section" aria-labelledby="calendar-events-heading">
        <div class="section-heading">
          <div><p class="eyebrow">Dates for your diary</p><h2 id="calendar-events-heading">Upcoming events</h2></div>
        </div>
        <div class="event-grid">
          {upcomingEvents.map((event) => (
            <article class="feature-card event-card">
              <p class="eyebrow"><time datetime={event.date}>{formatEventDate(event.date)}</time></p>
              <h3 class="event-title">{event.title}</h3>
              <p class="event-meta">
                {event.matchFormat}
                {event.restrictions ? ` · ${event.restrictions}` : ""}
                {event.pointType ? ` · ${event.pointType} masterpoints` : ""}
                {event.time ? ` · ${formatEventTime(event.time)}` : ""}
              </p>
              {event.description && <p>{event.description}</p>}
              {event.registration && <a class="text-link" href={event.registration} target="_blank" rel="noreferrer">Register <span aria-hidden="true">↗</span></a>}
            </article>
          ))}
        </div>
      </section>
    )}
    <article class="feature-card event-card competition-calendar-card">
      <p class="eyebrow">{page.competition.eyebrow}</p><h2>{page.competition.heading}</h2>
      <p>{page.competition.text}</p>
      <a class="text-link" href={page.competition.url} target="_blank" rel="noreferrer">{page.competition.action} <span aria-hidden="true">↗</span></a>
    </article>
    <section class="feature-card host-card calendar-hosts">
      <p class="eyebrow">{page.hosts.eyebrow}</p><h2>{page.hosts.heading}</h2>
      <p>{page.hosts.text}</p>
      <ul class="host-links">
        {hostedSessions.map((session) => <li><a href={session.hostRegistration} target="_blank" rel="noreferrer">Sign up as a host — {session.day} <span aria-hidden="true">↗</span></a></li>)}
      </ul>
    </section>
    <p class="schedule-note">{page.note}</p>
  </section>
</SiteLayout>
