---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout title="Visit us | Joondalup Bridge Club" description="Find Joondalup Bridge Club at Fleur Freame Pavilion in Padbury, Western Australia.">
  <section class="page-hero">
    <p class="eyebrow">Come and play</p>
    <h1>Visit the club</h1>
    <p>New and visiting players are welcome. Get in touch if you’d like help choosing a session.</p>
  </section>
  <section class="section page-content visit-grid">
    <article class="feature-card">
      <p class="eyebrow">Find us</p>
      <h2>Fleur Freame Pavilion</h2>
      <p>MacDonald Park<br />Padbury WA 6025</p>
      <a class="button button-primary" href="https://www.google.com/maps/place/-31.804067636043793,115.75700526367188">Open directions <span aria-hidden="true">↗</span></a>
    </article>
    <article class="feature-card">
      <p class="eyebrow">Before you arrive</p>
      <h2>A few useful details</h2>
      <ul>
        <li>Please be seated 15 minutes before the session.</li>
        <li>Session fees are $4 for members and $6 for visitors.</li>
        <li>Air-conditioned venue and free parking.</li>
      </ul>
      <a class="text-link" href="mailto:jbc6783@gmail.com">Email the club <span aria-hidden="true">→</span></a>
    </article>
  </section>
</SiteLayout>
