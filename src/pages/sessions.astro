---
import SiteLayout from "../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";
import page from "../data/pages/sessions.json";
import { getSessionPartnerLabel } from "../data/session-label";

const sessions = (await getCollection("sessions"))
  .map(({ data }) => data)
  .sort((a, b) => a.order - b.order);
const hostedSessions = sessions.filter((session) => session.hosted && session.hostRegistration);
---
<SiteLayout title="Session times | Joondalup Bridge Club" description="Weekly session times, partner requirements and formats at Joondalup Bridge Club.">
  <section class="page-hero">
    <p class="eyebrow">{page.hero.eyebrow}</p>
    <h1>{page.hero.heading}</h1>
    <p>{page.hero.intro}</p>
  </section>
  <section class="section page-content">
    <div class="notice-card"><strong>{page.partnerNotice.heading}</strong><span>{page.partnerNotice.text}</span></div>
    <div class="section-heading"><div><p class="eyebrow">{page.schedule.eyebrow}</p><h2>{page.schedule.heading}</h2></div><a class="text-link" href="/location/">{page.schedule.planVisit} <span aria-hidden="true">→</span></a></div>
    <div class="session-list session-list-full">
      {sessions.map((session) => (
        <article class="session-card">
          <div class="session-day">{session.day}</div>
          <div class="session-main">
            <h3>{session.title}</h3>
            <p>{session.matchFormat} · {session.sessionFormat} · {session.restrictions}</p>
            <p>{getSessionPartnerLabel(session)}</p>
            {session.host && <p class="session-person">Host · {session.host}</p>}
            {session.director && <p class="session-person">Director · {session.director}</p>}
          </div>
          <div class="session-time">{session.time}</div>
          {(session.registration || (session.hosted && session.hostRegistration)) && (
            <div class="session-actions">
              {session.registration && <a href={session.registration} target="_blank" rel="noreferrer">Register (required) <span aria-hidden="true">↗</span></a>}
              {session.hosted && session.hostRegistration && <a href={session.hostRegistration} target="_blank" rel="noreferrer">Sign up as a host <span aria-hidden="true">↗</span></a>}
            </div>
          )}
        </article>
      ))}
    </div>

    <div class="content-columns">
      <article class="feature-card">
        <p class="eyebrow">{page.formats.eyebrow}</p><h2>{page.formats.heading}</h2>
        <ul class="detail-list">
          {page.formats.items.map((item) => <li><strong>{item.name}</strong><span>{item.detail}</span></li>)}
        </ul>
      </article>
      <article class="feature-card host-card">
        <p class="eyebrow">{page.hosted.eyebrow}</p><h2>{page.hosted.heading}</h2>
        <p>{page.hosted.text}</p>
        <ul class="host-links">
          {hostedSessions.map((session) => <li><a href={session.hostRegistration} target="_blank" rel="noreferrer">Sign up as a host — {session.day} <span aria-hidden="true">↗</span></a></li>)}
        </ul>
      </article>
    </div>
    <div class="notice-card notice-plain"><strong>{page.beforeArrival.heading}</strong><span>{page.beforeArrival.text}</span></div>
  </section>
</SiteLayout>
