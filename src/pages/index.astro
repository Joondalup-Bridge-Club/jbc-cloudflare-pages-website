---
import SiteLayout from "../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";
import page from "../data/pages/home.json";
import { getSessionPartnerLabel } from "../data/session-label";
import { formatEventDate, formatEventTime, getUpcomingEvents } from "../data/event-utils";

const sessions = (await getCollection("sessions"))
  .map(({ data }) => data)
  .sort((a, b) => a.order - b.order);
const upcomingEvents = getUpcomingEvents(await getCollection("events"));
---

<SiteLayout
  title="Joondalup Bridge Club | Friendly bridge in Perth’s north"
  description="Find a bridge session, learn how to play, or plan a visit to Joondalup Bridge Club in Padbury. New and visiting players are welcome."
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow"><span class="eyebrow-dot"></span> {page.hero.eyebrow}</p>
      <h1>{page.hero.firstLine}<br /><em>{page.hero.secondLine}</em></h1>
      <p class="hero-lead">{page.hero.lead}</p>
      <div class="hero-actions">
        <a class="button button-primary" href="/sessions/">{page.hero.primaryAction} <span aria-hidden="true">→</span></a>
        <a class="button button-secondary" href="/education/">{page.hero.secondaryAction}</a>
      </div>
      <p class="hero-note">{page.hero.note}</p>
    </div>
    <div class="hero-art" aria-label="Illustration of four bridge cards">
      <div class="card card-back"><span>♣</span></div>
      <div class="card card-front"><b>A</b><span>♠</span><small>♠</small></div>
      <div class="art-caption">Everyone has a seat at the table.</div>
    </div>
  </section>

  <section class="section section-sessions" aria-labelledby="sessions-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{page.sessions.eyebrow}</p>
        <h2 id="sessions-heading">{page.sessions.heading}</h2>
      </div>
      <a class="text-link desktop-link" href="/sessions/">{page.sessions.allSessions} <span aria-hidden="true">→</span></a>
    </div>
    <div class="session-list">
      {sessions.map((session) => (
        <article class="session-card">
          <div class="session-day">{session.day}</div>
          <div class="session-main">
            <h3>{session.title}</h3>
            <p>{session.matchFormat} · {session.sessionFormat} · {session.restrictions}</p>
            <p>{getSessionPartnerLabel(session)}</p>
            {session.host && <p class="session-person">Host · {session.host}</p>}
            {session.director && <p class="session-person">Director · {session.director}</p>}
          </div>
          <div class="session-time">{session.time}</div>
          {(session.registration || (session.hosted && session.hostRegistration)) && (
            <div class="session-actions">
              {session.registration && <a href={session.registration} target="_blank" rel="noreferrer">Register (required) <span aria-hidden="true">↗</span></a>}
              {session.hosted && session.hostRegistration && <a href={session.hostRegistration} target="_blank" rel="noreferrer">Sign up as a host <span aria-hidden="true">↗</span></a>}
            </div>
          )}
        </article>
      ))}
    </div>
    <a class="text-link mobile-link" href="/sessions/">{page.sessions.mobileSessions} <span aria-hidden="true">→</span></a>
    <p class="schedule-note">{page.sessions.note}</p>
  </section>

  {upcomingEvents.length > 0 && (
    <section class="section upcoming-events-section" aria-labelledby="upcoming-events-heading">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Dates for your diary</p>
          <h2 id="upcoming-events-heading">Upcoming events</h2>
        </div>
        <a class="text-link" href="/calendar/">All club events <span aria-hidden="true">→</span></a>
      </div>
      <div class="event-grid">
        {upcomingEvents.slice(0, 3).map((event) => (
          <article class="feature-card event-card">
            <p class="eyebrow"><time datetime={event.date}>{formatEventDate(event.date)}</time></p>
            <h3 class="event-title">{event.title}</h3>
            <p class="event-meta">
              {event.matchFormat}
              {event.restrictions ? ` · ${event.restrictions}` : ""}
              {event.pointType ? ` · ${event.pointType} masterpoints` : ""}
              {event.time ? ` · ${formatEventTime(event.time)}` : ""}
            </p>
            {event.description && <p>{event.description}</p>}
            {event.registration && <a class="text-link" href={event.registration} target="_blank" rel="noreferrer">Register <span aria-hidden="true">↗</span></a>}
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="welcome-band">
    <div class="welcome-mark" aria-hidden="true">♠</div>
    <div>
      <p class="eyebrow">{page.welcome.eyebrow}</p>
      <h2>{page.welcome.heading}</h2>
      <p>{page.welcome.text}</p>
    </div>
    <a class="button button-light" href="/education/">{page.welcome.action} <span aria-hidden="true">→</span></a>
  </section>

  <section class="section quick-info" aria-label="Club information">
    {page.details.map((item) => (
      <article class="info-item">
        <strong>{item.value}</strong>
        <span>{item.label}</span>
      </article>
    ))}
    <a class="info-location" href="/location/">
      <span class="pin" aria-hidden="true">⌖</span>
      <span><strong>{page.location.venue}</strong><small>{page.location.detail}</small></span>
      <span class="info-arrow" aria-hidden="true">↗</span>
    </a>
  </section>

  <section class="section lower-cards">
    {page.lowerCards.map((card, index) => (
      <article class={`feature-card ${index === 0 ? "event-card" : "results-card"}`}>
        <p class="eyebrow">{card.eyebrow}</p>
        <h2>{card.heading}</h2>
        <p>{card.text}</p>
        <a class="text-link" href={index === 0 ? "/calendar/" : "/club/"}>{card.action} <span aria-hidden="true">→</span></a>
      </article>
    ))}
  </section>
</SiteLayout>
